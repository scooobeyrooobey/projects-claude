{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "carousel",
      "runtimeExecutable": "/usr/local/bin/node",
      "runtimeArgs": ["-e", "const h=require('http'),f=require('fs'),p=require('path'),m={'html':'text/html','css':'text/css','js':'application/javascript','png':'image/png','svg':'image/svg+xml','jpg':'image/jpeg'};h.createServer((q,r)=>{let u=q.url==='/'?'/index.html':decodeURIComponent(q.url);let fp=p.join('/Users/scoobieroobie/Documents/projects-claude/3d-carousel',u);f.readFile(fp,(e,d)=>{if(e){r.writeHead(404);r.end('Not found');return}let ext=p.extname(fp).slice(1);r.writeHead(200,{'Content-Type':m[ext]||'application/octet-stream'});r.end(d)})}).listen(8080)"],
      "port": 8080
    }
  ]
}
